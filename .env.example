# Server only. npm run setup generates a random token here in your private .env.
ADMIN_API_TOKEN=
DATABASE_PATH=.data/nova-dent.sqlite
PORT=4173
HOST=127.0.0.1
# Empty API URL uses the real backend on the same origin.
VITE_API_URL=
# Only set to true for an explicitly simulated demo.
VITE_MOCK_API=false

# Hosted Sites only (set in server settings, never in VITE variables):
# ADMIN_AUTH_MODE=sites
# ADMIN_ALLOWED_EMAILS=your-owner-email@example.com